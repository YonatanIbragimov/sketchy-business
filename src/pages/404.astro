---
import Base from "../layouts/Base.astro";
import Sprite from "../components/Sprite.astro";
---
<Base title="Page not found">
  <section class="wrap nf">
    <Sprite name="smudge" height={180} />
    <h1>Rubbed out.</h1>
    <p>This page has been tidied. Lord Smudge sends his regards. "Toodle-oo!"</p>
    <p><a class="btn" href="/">Back to the front page</a></p>
  </section>
</Base>
<style>
  .nf { text-align: center; padding-top: 64px; }
  .nf :global(.sprite) { margin: 0 auto 12px; display: block; }
</style>
