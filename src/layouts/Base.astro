---
import "../styles/global.css";
import release from "../data/release.json";
import { downloadUrl } from "../data/release";
// Early access: the installer link only appears after the passcode. (A light gate: it keeps the download off the open
// page, it isn't security - the code and the link are both in the page's script.)
const gateUrl = btoa(downloadUrl);

interface Props { title?: string; description?: string; wide?: boolean }
const { title, description = "A hand-drawn platformer about a doodle with an enormous head, a very rude narrator, and a pompous eraser who stole the Last Pencil. Free for Windows.", } = Astro.props;
const fullTitle = title ? `${title} · Sketchy Business` : "Sketchy Business: a hand-drawn platformer";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/", label: "Home" },
  { href: "/wiki", label: "Wiki" },
  { href: "/wiki/characters", label: "Cast" },
  { href: "/wiki/chapters", label: "Chapters" },
];
const ogImage = new URL("/og.jpg", Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gochi+Hand&family=Kalam:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- three slightly different pencil wobbles, cycled ~9 times a second like the game's line boil -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="boil-a"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="1" /><feDisplacementMap in="SourceGraphic" scale="3.2" /></filter>
      <filter id="boil-b"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" /><feDisplacementMap in="SourceGraphic" scale="3.2" /></filter>
      <filter id="boil-c"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="13" /><feDisplacementMap in="SourceGraphic" scale="3.2" /></filter>
    </svg>

    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="logo" href="/" aria-label="Sketchy Business home">
          <img src="/favicon.png" alt="" width="40" height="40" />
          <span>Sketchy <em>Business</em></span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || (n.href !== "/" && path.startsWith(n.href) && !nav.some(m => m.href.length > n.href.length && path.startsWith(m.href))) ? "page" : undefined}>{n.label}</a>
          ))}
          <a class="btn nav-dl" href="/download">Download</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <dialog id="gate" class="gate" aria-labelledby="gate-title">
      <form method="dialog" class="gate-in" id="gate-form">
        <h2 id="gate-title">Early access</h2>
        <p>Sketchy Business is invite-only for now. Enter the passcode you were given to download it.</p>
        <label for="gate-code">Passcode</label>
        <input id="gate-code" name="code" type="password" inputmode="numeric" autocomplete="off" required />
        <p class="gate-err" id="gate-err" role="alert" hidden>That's not the code. Try again.</p>
        <div class="gate-btns">
          <button type="button" class="btn ghost" id="gate-cancel">Cancel</button>
          <button type="submit" class="btn" id="gate-go">Download</button>
        </div>
      </form>
    </dialog>
    <script define:vars={{ gateUrl }}>
      (() => {
        const dlg = document.getElementById("gate");
        const form = document.getElementById("gate-form");
        const input = document.getElementById("gate-code");
        const err = document.getElementById("gate-err");
        const open = (e) => {
          e.preventDefault();
          err.hidden = true;
          input.value = "";
          if (dlg.showModal) dlg.showModal(); else dlg.setAttribute("open", "");
          input.focus();
        };
        document.querySelectorAll("[data-gate]").forEach((a) => a.addEventListener("click", open));
        document.getElementById("gate-cancel").addEventListener("click", () => dlg.close());
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          if (input.value.trim() === "1234") {
            dlg.close();
            window.location.href = atob(gateUrl);
          } else {
            err.hidden = false;
            input.select();
          }
        });
      })();
    </script>

    <footer class="foot">
      <div class="wrap">
        <p>
          <strong>Sketchy Business</strong> v{release.version} for Windows 10 &amp; 11 ·
          <a href="/download">Download</a> · <a href="/wiki">Wiki</a> · <a href="/wiki/faq">Help</a> ·
          <a href="#download" data-gate>All versions</a>
        </p>
        <p class="tiny">Drawn by hand, coded on a homemade engine called Graphite. No erasers were harmed. Several were humiliated.</p>
      </div>
    </footer>

    <style>
      .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(4px); border-bottom: 2px solid rgba(52,55,61,.18); }
      .top-in { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 64px; flex-wrap: wrap; padding-top: 6px; padding-bottom: 6px; }
      .logo { display: flex; align-items: center; gap: 10px; font-family: var(--font-hand); font-size: 1.7rem; color: var(--ink); text-decoration: none; line-height: 1; }
      .logo em { font-style: normal; color: var(--red); }
      .logo img { width: 40px; height: 40px; }
      nav { display: flex; align-items: center; gap: 4px 18px; flex-wrap: wrap; font-family: var(--font-hand); font-size: 1.3rem; }
      nav a:not(.btn) { color: var(--ink); text-decoration: none; padding: 2px 2px; }
      nav a:not(.btn):hover { color: var(--red); }
      nav a[aria-current="page"] { text-decoration: underline wavy var(--red) 2px; text-underline-offset: 6px; }
      .nav-dl { font-size: 1.15rem; padding: .45em .85em .4em; box-shadow: 2px 3px 0 var(--red); }
      @media (max-width: 560px) {
        .top { position: static; }
        nav { gap: 2px 14px; font-size: 1.15rem; }
      }
      .gate { border: 2px solid var(--ink); border-radius: 10px 6px 12px 8px; background: var(--paper); color: var(--ink);
        padding: 0; width: min(420px, calc(100vw - 32px)); box-shadow: 4px 6px 0 var(--red); }
      .gate::backdrop { background: rgba(30, 32, 36, .45); }
      .gate-in { padding: 22px 22px 18px; }
      .gate h2 { font-family: var(--font-hand); font-size: 2rem; margin: 0 0 6px; }
      .gate p { margin: 0 0 14px; line-height: 1.45; }
      .gate label { display: block; font-family: var(--font-hand); font-size: 1.2rem; margin-bottom: 4px; }
      .gate input { width: 100%; box-sizing: border-box; font: inherit; font-size: 1.2rem; padding: 10px 12px;
        border: 2px solid var(--ink); border-radius: 6px; background: #fff; color: var(--ink); }
      .gate input:focus { outline: 3px solid color-mix(in srgb, var(--red) 45%, transparent); outline-offset: 1px; }
      .gate-err { color: var(--red); margin: 8px 0 0 !important; }
      .gate-btns { display: flex; justify-content: flex-end; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
      .gate .ghost { background: transparent; box-shadow: none; }
      .foot { margin-top: 96px; padding: 32px 0 48px; border-top: 2px dashed rgba(52,55,61,.35); font-size: .95rem; }
      .foot p { margin: 0 0 8px; line-height: 1.6; }
      .tiny { color: var(--ink-faint); font-size: .85rem; }
    </style>
  </body>
</html>
